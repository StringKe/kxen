{
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node ../scripts/build.mjs website",
    "preview": "astro preview",
    "typecheck": "astro check",
