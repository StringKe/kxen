---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。" noindex>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-24 text-center">
      <p class="text-sm font-medium text-muted-foreground">404</p>
      <h1
        class="mt-2 text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        页面不存在
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        你访问的页面不存在或已被移动。
      </p>
      <a
        href="/"
        class="mt-8 inline-block rounded-lg border border-border px-4 py-2 font-medium text-foreground no-underline transition-colors hover:border-border-strong"
      >
        返回首页
      </a>
      <nav class="mt-10 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
        <a href="/overview/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">产品概览</a>
        <a href="/getting-started/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">开始使用</a>
        <a href="/workspace/workspace/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">Workspace</a>
        <a href="/models/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">模型与 Provider</a>
        <a href="/agent/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">Agent 与任务</a>
        <a href="/knowledge/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">知识与定制</a>
        <a href="/integrations/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">集成能力</a>
        <a href="/recovery/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">恢复与隔离</a>
        <a href="/reference/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">参考手册</a>
        <a href="/concepts/" class="text-muted-foreground no-underline transition-colors hover:text-foreground">核心概念</a>
      </nav>
    </main>
  </div>
</BaseLayout>
